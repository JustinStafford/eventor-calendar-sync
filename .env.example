# Copy to .env for local runs. Never commit .env.

# Required: any club's Eventor API key can read events.
EVENTOR_API_KEY=

# Optional: enables LLM classification. Without it, name patterns do the work.
# ANTHROPIC_API_KEY=

# Optional: another Eventor instance (default is Eventor Australia).
# EVENTOR_BASE_URL=https://eventor.orienteering.asn.au/api
